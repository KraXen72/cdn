<!doctype html>
<!-- Generated by build.py from markdown/. Edit the Markdown, then rebuild. -->
<html lang="sk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#100f0f">
  <meta name="description" content="Two-year Bible reading plan with saved progress and JSON backups.">
  <title>Part $part | Bible Reading Plan</title>
  <link rel="icon" href="./icon.svg" type="image/svg+xml">
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="stylesheet" href="./style.css">
</head>
<body data-part="$part" data-part-ends="$ends" data-total="$total">
  <header class="toolbar">
    <nav aria-label="Half-year parts">$navigation</nav>
    <div class="progress-tools" hidden>
      <span id="total-count"></span>
      <details id="backup-menu">
        <summary aria-label="Progress backup options">Backup</summary>
        <div class="menu-panel">
          <button type="button" id="export">Export progress</button>
          <button type="button" id="import">Import backup</button>
        </div>
      </details>
    </div>
  </header>
  <p id="save-status" role="status" hidden></p>
  <main class="markdown-rendered" id="content">$content</main>
  <button id="jump-unread" type="button" aria-label="Jump to next unread passage" title="Jump to next unread passage" hidden>
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M11 22.95v-2q-3.125-.35-5.363-2.587T3.05 13h-2v-2h2q.35-3.125 2.588-5.363T11 3.05v-2h2v2q3.125.35 5.363 2.588T20.95 11h2v2h-2q-.35 3.125-2.587 5.363T13 20.95v2zm5.95-6Q19 14.9 19 12t-2.05-4.95T12 5T7.05 7.05T5 12t2.05 4.95T12 19t4.95-2.05m-7.775-2.125Q8 13.65 8 12t1.175-2.825T12 8t2.825 1.175T16 12t-1.175 2.825T12 16t-2.825-1.175"/></svg>
  </button>
  <div class="toast" id="toast" role="status" hidden></div>
  <input id="import-file" type="file" accept="application/json,.json" hidden>
  <script src="./app.js"></script>
</body>
</html>
